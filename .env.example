# UrbanFlow API — Environment Variables
# Copy this file to api/.env and fill in your values

# MongoDB connection string
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret key — use a long, random string in production
SUPER_SECRET=change_me_to_a_long_random_secret

# Server port (defaults to 3000 if not set)
PORT=3000

# Node environment: development | production | test
NODE_ENV=development
