# UrbanFlow — Docker Compose / production environment
# Copy this file to `.env` (git-ignored) and fill in real values:
#   cp .env.example .env
#   docker compose up -d --build
#
# Generate strong secrets with:  openssl rand -hex 32

# --- MongoDB root credentials (initialise the containerised database) ------
MONGO_INITDB_ROOT_USERNAME=urbanflow_admin
# REQUIRED
MONGO_INITDB_ROOT_PASSWORD=

# --- Connection string used by the API ------------------------------------
# Inside the compose network the Mongo host is "mongodb".
# REQUIRED
DB_URL=mongodb://urbanflow_admin:CHANGE_ME@mongodb:27017/urbanflow?authSource=admin

# --- JWT signing secret (the API reads SUPER_SECRET) ----------------------
# REQUIRED
SUPER_SECRET=

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=3000
