# UrbanFlow Frontend Environment Variables
# Copy this file to frontend/.env for local development.
#
# Base URL of the UrbanFlow REST API. No trailing slash.
# In production this value is injected at build time by GitHub Actions
# (repository secret/variable VITE_API_URL) — never commit real values here.
VITE_API_URL=http://localhost:3000

# Optional: base path override. Defaults to /UrbanFlow/ for production builds
# (project GitHub Pages) and / for local dev. Only set this when the repository
# name changes.
# VITE_BASE_PATH=/UrbanFlow/
